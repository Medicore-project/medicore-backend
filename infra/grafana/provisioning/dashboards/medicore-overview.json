{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "MediCore — Service health, request rates, latency, Kafka consumer lag",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Service Health",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red",   "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "up{job=\"gateway\"}", "legendFormat": "Gateway", "refId": "A" } ],
      "title": "Gateway",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red",   "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "up{job=\"identity-api\"}", "legendFormat": "Identity", "refId": "A" } ],
      "title": "Identity Service",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red",   "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "up{job=\"patient-api\"}", "legendFormat": "Patient", "refId": "A" } ],
      "title": "Patient Service",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "orange", "index": 1, "text": "NOT YET" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "up{job=\"appointment-api\"}", "legendFormat": "Appointment", "refId": "A" } ],
      "title": "Appointment Service (Sprint 3)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "orange", "index": 1, "text": "NOT YET" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "up{job=\"billing-api\"}", "legendFormat": "Billing", "refId": "A" } ],
      "title": "Billing Service (Sprint 4)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Request Rate (req/s)",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "rate(http_requests_received_total{job=\"identity-api\"}[1m])", "legendFormat": "Identity — {{method}} {{route}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "rate(http_requests_received_total{job=\"gateway\"}[1m])", "legendFormat": "Gateway — {{method}} {{route}}", "refId": "B" }
      ],
      "title": "Identity & Gateway — Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "rate(http_requests_received_total{job=\"patient-api\"}[1m])", "legendFormat": "Patient — {{method}} {{route}}", "refId": "A" }
      ],
      "title": "Patient — Request Rate",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Error Rate (5xx)",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "rate(http_requests_received_total{job=\"identity-api\",code=~\"5..\"}[1m])", "legendFormat": "Identity 5xx", "refId": "A" }
      ],
      "title": "Identity — 5xx Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "rate(http_requests_received_total{job=\"patient-api\",code=~\"5..\"}[1m])", "legendFormat": "Patient 5xx", "refId": "A" }
      ],
      "title": "Patient — 5xx Error Rate",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Latency — p50 / p95 / p99",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"identity-api\"}[5m]))", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"identity-api\"}[5m]))", "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"identity-api\"}[5m]))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "Identity — Latency Percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-medicore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"patient-api\"}[5m]))", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"patient-api\"}[5m]))", "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus-medicore" }, "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"patient-api\"}[5m]))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "Patient — Latency Percentiles",
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["medicore", "sprint-2"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MediCore — Overview",
  "uid": "medicore-overview",
  "version": 1
}
