+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Coverage settings for the SE3112 unit-testing suite.
+  Measures only the Application layer (the business logic these tests target) and leaves out
+  generated code and plain data carriers, so the percentage reflects logic, not DTO padding.
+-->
+<RunSettings>
+  <DataCollectionRunSettings>
+    <DataCollectors>
+      <DataCollector friendlyName="XPlat code coverage">
+        <Configuration>
+          <Format>cobertura</Format>
+          <Include>[MediCore.Appointment.Application]*</Include>
+          <Exclude>[MediCore.Appointment.Application]MediCore.Appointment.Application.DTOs.*</Exclude>
+          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
+          <SkipAutoProps>true</SkipAutoProps>
+          <DeterministicReport>false</DeterministicReport>
+        </Configuration>
+      </DataCollector>
+    </DataCollectors>
+  </DataCollectionRunSettings>
+</RunSettings>
