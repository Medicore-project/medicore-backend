+using System.Collections;
+using MediCore.Appointment.Application.Entities;
+using MediCore.Appointment.UnitTests.Support;
+
+namespace MediCore.Appointment.UnitTests.DomainRules;
+
+/// <summary>
+/// The appointment state machine, tested exhaustively: every (from, to) pair of the four statuses
+/// plus an unknown one, generated by a <see cref="ClassData"/> source instead of 25 hand-written tests.
+/// </summary>
+[Trait(TestCategories.Category, TestCategories.Unit)]
+[Trait(TestCategories.Feature, TestCategories.DomainRules)]
+[Trait(TestCategories.Technique, TestCategories.Parameterized)]
+public sealed class AppointmentStatusTransitionsTests
+{
+    [Theory]
+    [ClassData(typeof(TransitionMatrix))]
+    public void CanTransition_matches_the_documented_state_machine(string from, string to, bool allowed)
+    {
+        Assert.Equal(allowed, AppointmentStatusTransitions.CanTransition(from, to));
+    }
+
+    [Theory]
+    [InlineData(AppointmentStatus.Booked, false)]
+    [InlineData(AppointmentStatus.Cancelled, true)]
+    [InlineData(AppointmentStatus.Completed, true)]
+    [InlineData(AppointmentStatus.NoShow, true)]
+    [InlineData("Archived", true)]  // an unknown status is treated as terminal: fail closed
+    [InlineData("booked", true)]    // ordinal comparison: wrong case is unknown
+    public void IsTerminal_is_true_for_every_status_with_no_way_out(string status, bool terminal)
+    {
+        Assert.Equal(terminal, AppointmentStatusTransitions.IsTerminal(status));
+    }
+
+    /// <summary>
+    /// Booked -> {Booked (reschedule), Cancelled, Completed, NoShow}; every other status is terminal.
+    /// </summary>
+    private sealed class TransitionMatrix : IEnumerable<object[]>
+    {
+        private static readonly string[] Statuses =
+        [
+            AppointmentStatus.Booked,
+            AppointmentStatus.Cancelled,
+            AppointmentStatus.Completed,
+            AppointmentStatus.NoShow,
+            "Unknown"
+        ];
+
+        public IEnumerator<object[]> GetEnumerator()
+        {
+            foreach (var from in Statuses)
+            {
+                foreach (var to in Statuses)
+                {
+                    var allowed = from == AppointmentStatus.Booked && to != "Unknown";
+                    yield return new object[] { from, to, allowed };
+                }
+            }
+        }
+
+        IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
+    }
+}
