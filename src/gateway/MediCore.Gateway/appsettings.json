{
  // =============================================================================
  // MediCore Gateway — appsettings.json
  // Production-safe defaults. Development overrides live in appsettings.Development.json
  // =============================================================================

  "AllowedHosts": "*",

  // ---------------------------------------------------------------------------
  // Seq structured log ingestion URL
  // In production this should be the private Seq endpoint; overridden in dev.
  // ---------------------------------------------------------------------------
  "Seq": {
    "ServerUrl": "http://seq:5341"
  },

  // ---------------------------------------------------------------------------
  // Serilog
  // ---------------------------------------------------------------------------
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },

  // ---------------------------------------------------------------------------
  // CORS — allowlist of origins permitted to call the gateway.
  // The frontend running on localhost:3000 is added in appsettings.Development.json.
  // ---------------------------------------------------------------------------
  "Cors": {
    "AllowedOrigins": []
  },

  // ---------------------------------------------------------------------------
  // Upstream service base URLs — used by aggregated health checks only.
  // YARP has its own cluster addresses in the ReverseProxy section below.
  // In production these are the internal k8s service names.
  // ---------------------------------------------------------------------------
  "Services": {
    "Identity":    "http://identity-api:8080",
    "Patient":     "http://patient-api:8080",
    "Appointment": "http://appointment-api:8080",
    "Billing":     "http://billing-api:8080"
  },

  // ---------------------------------------------------------------------------
  // YARP Reverse Proxy configuration
  // ---------------------------------------------------------------------------
  "ReverseProxy": {

    // ── Routes ──────────────────────────────────────────────────────────────
    // Each route maps a URL pattern to a cluster.
    // "RateLimiterPolicy" applies named rate-limit policies defined in Program.cs.
    "Routes": {

      // ── Identity service — LIVE ──────────────────────────────────────────
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          // Strip the /identity prefix before forwarding to the upstream
          { "PathPattern": "/{**catch-all}" }
        ]
      },

      // Login endpoint — stricter rate limit (5 req/min)
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-login",
        "Match": {
          "Path": "/auth/login",
          "Methods": [ "POST" ]
        }
      },

      // Auth routes (token refresh, logout) — global rate limit
      "auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/auth/{**catch-all}" }
        ]
      },

      // ── Patient service — STUBBED ────────────────────────────────────────
      "patient-route": {
        "ClusterId": "patient-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/patient/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },

      // ── Appointment service — STUBBED ────────────────────────────────────
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/appointment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },

      // ── Billing service — STUBBED ────────────────────────────────────────
      "billing-route": {
        "ClusterId": "billing-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/billing/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },

    // ── Clusters ─────────────────────────────────────────────────────────────
    // Each cluster is one upstream service with health-check configuration.
    "Clusters": {

      "identity-cluster": {
        "Destinations": {
          "identity-primary": {
            "Address": "http://identity-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },

      "patient-cluster": {
        "Destinations": {
          "patient-primary": {
            "Address": "http://patient-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },

      "appointment-cluster": {
        "Destinations": {
          "appointment-primary": {
            "Address": "http://appointment-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },

      "billing-cluster": {
        "Destinations": {
          "billing-primary": {
            "Address": "http://billing-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      }
    }
  }
}
