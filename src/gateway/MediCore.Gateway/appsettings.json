{
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://seq:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://proud-water-0f2255f00.5.azurestaticapps.net"
    ]
  },
  "Services": {
    "Identity":    "https://medicore-identity.azurewebsites.net",
    "Patient":     "http://patient-api:8080",
    "Appointment": "http://appointment-api:8080",
    "Billing":     "http://billing-api:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "identity-login-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "auth-login",
        "Match": {
          "Path": "/auth/login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "/api/auth/login" }
        ]
      },
      "auth-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "staff-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/staff/{**catch-all}" }
      },
      "departments-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/departments/{**catch-all}" }
      },
      "specializations-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/specializations/{**catch-all}" }
      },
      "roles-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },
      "reports-route": {
        "ClusterId": "identityCluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "patient-route": {
        "ClusterId": "patientCluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/patient/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "appointment-route": {
        "ClusterId": "appointmentCluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/appointment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "billing-route": {
        "ClusterId": "billingCluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/billing/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "identityPrimary": {
            "Address": "https://medicore-identity.azurewebsites.net"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },
      "patientCluster": {
        "Destinations": {
          "patientPrimary": {
            "Address": "http://patient-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },
      "appointmentCluster": {
        "Destinations": {
          "appointmentPrimary": {
            "Address": "http://appointment-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },
      "billingCluster": {
        "Destinations": {
          "billingPrimary": {
            "Address": "http://billing-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      }
    }
  }
}
