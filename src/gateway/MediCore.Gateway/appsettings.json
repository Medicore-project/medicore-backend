{
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://seq:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://proud-water-0f2255f00.5.azurestaticapps.net"
    ]
  },
  "Services": {
    "Identity":    "https://medicore-identity.azurewebsites.net",
    "Patient":     "http://patient-api:8080",
    "Appointment": "http://appointment-api:8080",
    "Billing":     "http://billing-api:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-login",
        "Match": {
          "Path": "/auth/login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "/api/auth/login" }
        ]
      },
      "auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "staff-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/staff/{**catch-all}" }
      },
      "departments-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/departments/{**catch-all}" }
      },
      "specializations-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/specializations/{**catch-all}" }
      },
      "roles-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "global",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/patient/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/appointment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/billing/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-primary": {
            "Address": "http://identity-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-primary": {
            "Address": "http://patient-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },
      "appointment-cluster": {
        "Destinations": {
          "appointment-primary": {
            "Address": "http://appointment-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing-primary": {
            "Address": "http://billing-api:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true
          }
        }
      }
    }
  }
}
