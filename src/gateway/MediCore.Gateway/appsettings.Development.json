{
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Yarp": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "Services": {
    "Identity": "http://localhost:5001",
    "Patient": "http://localhost:5002",
    "Appointment": "http://localhost:5003",
    "Billing": "http://localhost:5004"
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-primary": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-primary": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "appointment-cluster": {
        "Destinations": {
          "appointment-primary": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing-primary": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}