{
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Yarp": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "Services": {
    "Identity": "http://localhost:5001",
    "Patient": "http://localhost:5002",
    "Appointment": "http://localhost:5003",
    "Billing": "http://localhost:5004"
  },
  "ReverseProxy": {
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "identityPrimary": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "patientCluster": {
        "Destinations": {
          "patientPrimary": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "appointmentCluster": {
        "Destinations": {
          "appointmentPrimary": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "billingCluster": {
        "Destinations": {
          "billingPrimary": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}