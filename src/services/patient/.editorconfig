# =============================================================================
# .editorconfig — Patient service code style and analyzer severities
# =============================================================================
# Applies to every file under src/services/patient. Read by the IDE
# (VS / VS Code / Rider) and by `dotnet build` through EnforceCodeStyleInBuild
# (see Directory.Build.props in this folder).
#   suggestion → shown in the IDE only
#   warning    → reported on every build and counted by the code-quality workflow
# =============================================================================

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,xml,runsettings,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Usings and namespaces ----------------------------------------------------
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# --- Language preferences -------------------------------------------------------
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:silent
dotnet_style_readonly_field = true:warning
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# --- Naming ---------------------------------------------------------------------
# Interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# Types and public members are PascalCase
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# Private fields are _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Constants are PascalCase (takes precedence over the private-field rule)
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

# --- Maintainability metrics ----------------------------------------------------
# Cyclomatic complexity above the CodeMetricsConfig.txt threshold (15)
dotnet_diagnostic.CA1502.severity = warning
# Unused private members / parameters
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
# Unused local variables / assignments
dotnet_diagnostic.IDE0059.severity = warning

# --- Reliability ------------------------------------------------------------------
# Forward CancellationToken to methods that accept one
dotnet_diagnostic.CA2016.severity = warning
# Dispose objects before losing scope
dotnet_diagnostic.CA2000.severity = warning
# Do not catch general exception types (reported, reviewed case by case)
dotnet_diagnostic.CA1031.severity = suggestion
# ConfigureAwait is not needed in ASP.NET Core apps
dotnet_diagnostic.CA2007.severity = none

# --- Security ---------------------------------------------------------------------
# Review SQL queries for injection vulnerabilities (raw ADO.NET reports)
dotnet_diagnostic.CA2100.severity = warning

# --- Noise reduction ----------------------------------------------------------------
# Identifiers clashing with VB keywords (e.g. `to`, `date`): C#-only codebase
dotnet_diagnostic.CA1716.severity = none
# Logging message templates: LoggerMessage delegates are not required for this project
dotnet_diagnostic.CA1848.severity = suggestion
# Culture-specific string APIs
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion

# EF Core migrations are generated code
[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Tests: xUnit naming (Method_Scenario_Result) uses underscores
[*.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2000.severity = suggestion
