{
  "ConnectionStrings": {
    "BillingDatabase": "Host=localhost;Port=5432;Database=medicore;Username=billing_svc;Password=billing_pass;SearchPath=medicore_billing"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "AppointmentConsumer": {
      "Topic": "appointment-events",
      "GroupId": "medicore-billing",
      "RetryDelaySeconds": 2
    },
    "NotificationConsumer": {
      "GroupId": "medicore-billing-notifications",
      "Topics": [ "patient-events", "appointment-events", "billing-events" ],
      "RetryDelaySeconds": 2,
      "MaxDeliveryAttempts": 3
    }
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "SendTimeoutSeconds": 10,
    "FromAddress": "noreply@medicore.local",
    "FromName": "MediCore"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
