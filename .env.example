# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Superuser credentials (used only by the init script)
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_dev

# ─── Identity service connection string ──────────────────────────────────────
IDENTITY_DB_CONNECTION=Host=localhost;Port=5432;Database=postgres;SearchPath=medicore_identity;Username=identity_svc;Password=identity_dev

# ─── Patient service connection string ───────────────────────────────────────
PATIENT_DB_CONNECTION=Host=localhost;Port=5432;Database=postgres;SearchPath=medicore_patient;Username=patient_svc;Password=patient_dev

# ─── Appointment service connection string ───────────────────────────────────
APPOINTMENT_DB_CONNECTION=Host=localhost;Port=5432;Database=postgres;SearchPath=medicore_appointment;Username=appointment_svc;Password=appointment_dev

# ─── Billing service connection string ───────────────────────────────────────
BILLING_DB_CONNECTION=Host=localhost;Port=5432;Database=postgres;SearchPath=medicore_billing;Username=billing_svc;Password=billing_dev

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── JWT (shared between Identity service and API Gateway) ───────────────────
# Generate a strong random key: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_64_CHARS
JWT_ISSUER=medicore-identity
JWT_AUDIENCE=medicore-api

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_dev

# ─── MailHog SMTP (local only, no real credentials needed) ───────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
