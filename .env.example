# =============================================================================
# MediCore — Environment variables template
# Copy this file to .env and fill in your local values.
# NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=medicore_admin
POSTGRES_PASSWORD=medicore_pass
POSTGRES_PORT=5432

# Per-service connection strings (used in appsettings.Development.json or env override)
# Format: Host=localhost;Port=5432;Database=medicore;Username=<role>;Password=<pass>
IDENTITY_DB_CONNECTION=Host=localhost;Port=5432;Database=medicore;Username=identity_svc;Password=identity_pass;Search Path=medicore_identity
PATIENT_DB_CONNECTION=Host=localhost;Port=5432;Database=medicore;Username=patient_svc;Password=patient_pass;Search Path=medicore_patient
APPOINTMENT_DB_CONNECTION=Host=localhost;Port=5432;Database=medicore;Username=appointment_svc;Password=appointment_pass;Search Path=medicore_appointment
BILLING_DB_CONNECTION=Host=localhost;Port=5432;Database=medicore;Username=billing_svc;Password=billing_pass;Search Path=medicore_billing

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# KRaft cluster ID — generate once with: kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MediCoreKraftCluster00
KAFKA_HOST_PORT=29092

# Bootstrap server used by dotnet services running on the HOST machine
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ---------------------------------------------------------------------------
# Kafka UI
# ---------------------------------------------------------------------------
KAFKA_UI_PORT=8080

# ---------------------------------------------------------------------------
# Seq
# ---------------------------------------------------------------------------
SEQ_PORT=5341
SEQ_INGEST_PORT=5342

# Seq ingest URL for Serilog HTTP sink (services running on host)
SEQ_INGEST_URL=http://localhost:5342

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# MailHog
# ---------------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# SMTP settings for services (when running on host)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@medicore.local

# ---------------------------------------------------------------------------
# JWT (Identity service only)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_ISSUER=medicore-identity
JWT_AUDIENCE=medicore-api
JWT_EXPIRY_MINUTES=60
